# Normalise line endings. Without this, committing from Windows stores CRLF
# and every file shows as fully rewritten in diffs on Linux/macOS and CI.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.JPG binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
