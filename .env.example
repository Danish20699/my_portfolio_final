# Copy to .env.local for local testing with `vercel dev`.
# For production, set these in the Vercel dashboard:
#   Project → Settings → Environment Variables

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — where contact-form enquiries are delivered.
# Defaults to danishpersonal6@gmail.com
# MAIL_TO=danishpersonal6@gmail.com

# Optional — the sender address.
# Resend's shared "onboarding@resend.dev" needs no domain setup, but it can
# ONLY deliver to the email your Resend account was registered with. That is
# fine while enquiries go to your own inbox. Once you verify a domain in
# Resend, set this to an address on it.
# MAIL_FROM=Portfolio <hello@yourdomain.com>
